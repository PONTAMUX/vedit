{
  "doc": "強い強調: impact + 集中線(最初の 1.6 秒)+ 背景(V1)の揺れ。フラッシュは少し長め",
  "required": [["text", "file"]],
  "params": {
    "text": null, "file": null, "gap_at": null,
    "style": "impact", "pos": [0.5, 0.5], "track": 6, "out_anim": "fade",
    "flash": true, "flash_dur": 0.16, "flash_track": 8,
    "lines": 1.6, "lines_track": 5, "shake": true,
    "se": {"$pick": ["se/文字表示の衝撃音2.mp3", "se/文字表示の衝撃音3.mp3", "se/文字表示の衝撃音1.mp3"]},
    "se_gain": "match:ぽペン"
  },
  "styles": {
    "impact": {"font": "HGP明朝E", "size": 200, "color": "#E0201C", "outlines": [{"color": "#000000", "width": 17}, {"color": "#FFFFFF", "width": 6}]}
  },
  "items": [
    {"to": "telops", "if": "text", "item": {"text": "$text", "start": "$start", "end": "$end", "gap_at": "$gap_at", "style": "$style", "pos": "$pos", "in_anim": "pop", "out_anim": "$out_anim", "anim_dur": 0.12}},
    {"to": "overlays", "if": "file", "item": {"file": "$file", "start": "$start", "end": "$end", "gap_at": "$gap_at", "pos": "full", "track": "$track", "in_anim": "pop", "out_anim": {"type": "fade", "dur": 0.12}}},
    {"to": "overlays", "if": "lines", "item": {"kind": "speedlines", "start": "$start", "end": "$=min(end, start + lines)", "gap_at": "$gap_at", "track": "$lines_track", "in_anim": {"type": "fade", "dur": 0.15}, "out_anim": {"type": "fade", "dur": 0.15}}},
    {"to": "overlays", "if": "flash", "item": {"kind": "flash", "start": "$start", "end": "$=start + flash_dur", "gap_at": "$gap_at", "track": "$flash_track", "params": {"dur": "$flash_dur"}}},
    {"to": "v1_fx", "if": "!gap_at", "item": {"type": "shake", "start": "$start"}},
    {"to": "sfx", "if": "se", "item": {"file": "$se", "start": "$start", "gap_at": "$gap_at", "gain_db": "$se_gain"}}
  ]
}
